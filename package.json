{
  "name": "api-doctor",
  "version": "1.0.0",
  "description": "AI-Powered API Debugging & Repair Agent",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "test": "cd backend && npm test",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../examples/broken-express-api && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "api",
    "debugging",
    "ai",
    "express",
    "repair"
  ],
  "author": "",
  "license": "MIT"
}
